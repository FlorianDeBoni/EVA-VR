# OpenAI
OPENAI_API_KEY = "your_openai_api_key_here"
OPENAI_IMAGE_MODEL = "gpt-image-2"
GPT_COMPLETION_MODEL = "your_vision_model_here"

MAX_PAST_IMAGES = 3
DEFAULT_MODEL = "gpt-image-2"
IMAGE_SEARCH_TOP_K = 3
# Thumbnails sent per vision call; keeps each request small and the scores consistent
IMAGE_RANK_BATCH_SIZE = 10

API_PORT = 8888

# Image search scoring
KEYWORD_WEIGHT = 2.0
CATEGORY_WEIGHT = 1.0
# Comma-separated hosts that mostly serve stock/vector/low-signal images
BLOCKED_HOSTS = "pinterest.,alamy.,shutterstock.,istockphoto.,dreamstime."

# Speech to text
OPENAI_STT_MODEL = "gpt-4o-transcribe"
# OpenAI rejects audio files larger than 25 MB
STT_MAX_AUDIO_BYTES = 26214400

# Application database (credentials: same as POSTGRES_* in infrastructure/.env.infrastructure)
# host.docker.internal reaches the database from the backend container; use localhost outside Docker
DB_HOST = "host.docker.internal"
DB_PORT = 5432
DB_USER = "postgres"
DB_PASSWORD = "postgres"
DB_NAME = "eva_vr"

# Conversational agent
OPENAI_CHAT_MODEL = "gpt-4.1"

# Langfuse (prompts): keys are the auto-provisioned ones from infrastructure/.env.infrastructure
# host.docker.internal reaches Langfuse from the backend container; use localhost outside Docker
LANGFUSE_HOST = "http://host.docker.internal:3000"
LANGFUSE_PUBLIC_KEY = "pk-lf-dev"
LANGFUSE_SECRET_KEY = "sk-lf-dev"
# Label served by the app; `task seed:prompts` publishes the markdown prompts under it
LANGFUSE_PROMPT_LABEL = "production"

# Logging
LOG_LEVEL = "INFO"
LOG_FORMAT = "%(asctime)s %(levelname)-8s %(name)s: %(message)s"
