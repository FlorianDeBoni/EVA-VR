# Port of the dev server. Keep it in sync with CORS_ORIGINS in backend/.env.backend.
FRONTEND_PORT=5173

# Public path of the app (must start and end with /). Use /eva-vr/ behind the reverse proxy.
VITE_BASE_PATH=/

# Backend API called directly from the browser
VITE_API_URL=http://localhost:8888
# Behind the reverse proxy: VITE_API_URL=/eva-vr/api

# Delay between two automatic healthchecks (milliseconds)
VITE_HEALTH_POLL_MS=5000

# Recordings that are shorter or quieter than this are not sent for transcription:
# the model would invent text from silence. Level = loudest moment (0 = silence, 1 = maximum).
VITE_STT_MIN_MS=500
VITE_STT_MIN_LEVEL=0.01
